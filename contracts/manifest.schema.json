{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "postbell-manifest-1",
  "title": "Postbell content package, version 1",
  "description": "The manifest.json the content pipeline writes to each package folder. This file is the single source: Postbell generates its types and validator from it (npm run contract). Field meanings are in contracts/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "brand", "date", "language", "title", "approval", "files", "entries", "sources", "aiUsage"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "brand": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 40 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "language": { "enum": ["en", "tr"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "approval": { "enum": ["approved", "pending", "revision"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "role", "path", "width", "height"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 40 },
          "kind": { "enum": ["video", "image"] },
          "role": { "enum": ["main", "detail", "card"] },
          "path": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$", "maxLength": 200 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "durationSec": { "type": "number", "minimum": 0 }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "file", "text", "aiLabel"],
        "properties": {
          "platform": { "enum": ["x", "instagram-reels", "instagram-post", "tiktok", "youtube-shorts", "pinterest"] },
          "file": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 40 },
          "text": { "type": "string", "maxLength": 5000 },
          "aiLabel": { "type": "boolean" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "license"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "url": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2000 },
          "license": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "aiUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice", "visuals", "text"],
      "properties": {
        "voice": { "type": "boolean" },
        "visuals": { "type": "boolean" },
        "text": { "type": "boolean" }
      }
    }
  }
}
